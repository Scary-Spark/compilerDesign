// ======= Keywords and Identifiers =======
input a;
input constValue = 12;
intput wrongKeyword;  // should be identifier, not keyword

// ======= Numbers =======
input x = 42;          // normal integer
input y = 3.14;        // float
input z = .5;          // leading dot float
input w = 12.2.2;      // invalid number
input u = 7a;          // invalid character after number

// ======= Strings =======
input str1 = "Hello, World!";
input str2 = "This is a multi
line string";          // unclosed string error
input str3 = "Escaped \\n character"; // check escaped \n

// ======= Operators =======
input op1 = a + b - c * d / e;

// ======= Delimiters =======
input arr = [1,2,3];   // check , and ; delimiters

// ======= Comments =======
input commented = 10; // this is a single line comment
/* Multi-line
   comment example */
input afterComment = 20;

// ======= Errors =======
input = ;              // missing identifier
input ;                // missing identifier and value
input $invalid = 5;    // invalid identifier character